# O checkout fica indisponível de forma segura enquanto estas variáveis não existirem.
# Nunca use NEXT_PUBLIC_ para chaves do Asaas nem para o segredo da API da Lotti.

ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# API da Lotti (Railway), sem /api no final. Pedidos, eventos e o acesso da conta
# passam por /api/checkout/*. Em desenvolvimento, http://localhost:3001 é aceito.
LOTTI_API_URL=
# Segredo compartilhado com a API (mesmo valor de CHECKOUT_API_TOKEN na API, 32+ caracteres).
CHECKOUT_API_TOKEN=

# Lista separada por vírgulas. Em desenvolvimento, inclua http://localhost:3000.
CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000

# Ativar somente após chave, webhook e API (com LOTTI_APP_PASSWORD_SETUP_URL) homologados.
CHECKOUT_ENABLED=false
